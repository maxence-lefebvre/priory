[Unit]
Description=Priory GitHub intake
After=network-online.target
# Start only once a person wrote the environment file.
ConditionPathExists=%h/.config/priory/env

[Service]
EnvironmentFile=%h/.config/priory/env
ExecStart=%h/.cargo/bin/priory intake ${PRIORY_FACTORY}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
