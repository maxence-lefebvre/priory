{
  "$id": "https://raw.githubusercontent.com/maxence-lefebvre/priory/main/docs/schemas/events/priory.ask.applied.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "AskApplied": {
      "additionalProperties": false,
      "description": "A runner applied or refused an answer or dismiss that another machine sent to one of its asks.",
      "properties": {
        "ask": {
          "description": "The ask's id on that runner.",
          "format": "int64",
          "type": "integer"
        },
        "outcome": {
          "description": "`answered`, `dismissed` or `refused`.",
          "type": "string"
        },
        "runner": {
          "description": "The runner that owns the ask.",
          "type": "string"
        },
        "submission": {
          "description": "The `id` of the `priory.ask.answered` or `priory.ask.dismissed` message.",
          "format": "uuid",
          "type": "string"
        },
        "why": {
          "description": "Why it was refused.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "runner",
        "ask",
        "submission",
        "outcome"
      ],
      "type": "object"
    },
    "Link": {
      "additionalProperties": false,
      "description": "A link for people.",
      "properties": {
        "label": {
          "description": "`issue` or `pull_request`.",
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "url"
      ],
      "type": "object"
    }
  },
  "description": "A runner applied or refused an answer or dismiss that another machine sent to one of its asks.",
  "properties": {
    "data": {
      "$ref": "#/definitions/AskApplied"
    },
    "id": {
      "description": "A UUIDv5 of the message's name, so a retried publish keeps its id.",
      "format": "uuid",
      "type": "string"
    },
    "links": {
      "description": "GitHub and Linear events carry one link to the event's page.",
      "items": {
        "$ref": "#/definitions/Link"
      },
      "type": "array"
    },
    "subject": {
      "description": "A short line for listings, such as `owner/name#42`.",
      "type": "string"
    },
    "time": {
      "description": "When the event happened, RFC 3339.",
      "format": "date-time",
      "type": "string"
    },
    "type": {
      "const": "priory.ask.applied",
      "description": "The message type, such as `github.issues.labeled`.",
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "subject",
    "time",
    "data",
    "links"
  ],
  "title": "priory.ask.applied",
  "type": "object"
}
