{
  "$id": "https://raw.githubusercontent.com/maxence-lefebvre/priory/main/docs/schemas/events/priory.task.dropped.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Link": {
      "additionalProperties": false,
      "description": "A link for people.",
      "properties": {
        "label": {
          "description": "`issue` or `pull_request`.",
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "url"
      ],
      "type": "object"
    },
    "TaskDropped": {
      "additionalProperties": false,
      "description": "A person drops the requests of a key that no runner claimed, with `priory cancel KEY`. Every\nmachine drops them as it reads this, unless a runner's claim won the key before it on the log.",
      "properties": {
        "by": {
          "description": "Where the drop came from: `cli`.",
          "type": "string"
        },
        "key": {
          "description": "The key.",
          "type": "string"
        }
      },
      "required": [
        "key",
        "by"
      ],
      "type": "object"
    }
  },
  "description": "A person drops the requests of a key that no runner claimed, with `priory cancel KEY`. Every\nmachine drops them as it reads this, unless a runner's claim won the key before it on the log.",
  "properties": {
    "data": {
      "$ref": "#/definitions/TaskDropped"
    },
    "id": {
      "description": "A UUIDv5 of the message's name, so a retried publish keeps its id.",
      "format": "uuid",
      "type": "string"
    },
    "links": {
      "description": "GitHub and Linear events carry one link to the event's page.",
      "items": {
        "$ref": "#/definitions/Link"
      },
      "type": "array"
    },
    "subject": {
      "description": "A short line for listings, such as `owner/name#42`.",
      "type": "string"
    },
    "time": {
      "description": "When the event happened, RFC 3339.",
      "format": "date-time",
      "type": "string"
    },
    "type": {
      "const": "priory.task.dropped",
      "description": "The message type, such as `github.issues.labeled`.",
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "subject",
    "time",
    "data",
    "links"
  ],
  "title": "priory.task.dropped",
  "type": "object"
}
