{
  "$id": "https://raw.githubusercontent.com/maxence-lefebvre/priory/main/docs/schemas/events/github.issues.labeled.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "IssueLabeled": {
      "additionalProperties": false,
      "description": "A GitHub issue labeled, from the repository's issue events.",
      "properties": {
        "actor": {
          "description": "The GitHub login who added the label; null for a deleted user.",
          "type": [
            "string",
            "null"
          ]
        },
        "baseline": {
          "description": "True when the event came from the first poll of its stream.",
          "type": "boolean"
        },
        "delivery": {
          "description": "The `X-GitHub-Delivery` of the webhook delivery that reported it; absent when a poll did.\nGitHub does not sign it.",
          "type": [
            "string",
            "null"
          ]
        },
        "github_id": {
          "description": "GitHub's issue event id; null from a webhook, whose payload lacks it.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "issue": {
          "description": "The issue number.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "label": {
          "description": "The label added.",
          "type": [
            "string",
            "null"
          ]
        },
        "repo": {
          "description": "`owner/name`.",
          "type": "string"
        },
        "time": {
          "description": "When the event happened, RFC 3339.",
          "format": "date-time",
          "type": "string"
        },
        "title": {
          "description": "The issue title when the intake saw the event.",
          "type": "string"
        },
        "triggers": {
          "description": "The triggers the event matched, so the triggers it requests tasks for; may be empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "url": {
          "description": "The issue's page on GitHub.",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "issue",
        "title",
        "url",
        "label",
        "actor",
        "github_id",
        "time",
        "baseline",
        "triggers"
      ],
      "type": "object"
    },
    "Link": {
      "additionalProperties": false,
      "description": "A link for people.",
      "properties": {
        "label": {
          "description": "`issue` or `pull_request`.",
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "url"
      ],
      "type": "object"
    }
  },
  "description": "A GitHub issue labeled, from the repository's issue events.",
  "properties": {
    "data": {
      "$ref": "#/definitions/IssueLabeled"
    },
    "id": {
      "description": "A UUIDv5 of the message's name, so a retried publish keeps its id.",
      "format": "uuid",
      "type": "string"
    },
    "links": {
      "description": "GitHub and Linear events carry one link to the event's page.",
      "items": {
        "$ref": "#/definitions/Link"
      },
      "type": "array"
    },
    "subject": {
      "description": "A short line for listings, such as `owner/name#42`.",
      "type": "string"
    },
    "time": {
      "description": "When the event happened, RFC 3339.",
      "format": "date-time",
      "type": "string"
    },
    "type": {
      "const": "github.issues.labeled",
      "description": "The message type, such as `github.issues.labeled`.",
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "subject",
    "time",
    "data",
    "links"
  ],
  "title": "github.issues.labeled",
  "type": "object"
}
