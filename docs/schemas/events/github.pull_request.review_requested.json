{
  "$id": "https://raw.githubusercontent.com/maxence-lefebvre/priory/main/docs/schemas/events/github.pull_request.review_requested.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Link": {
      "additionalProperties": false,
      "description": "A link for people.",
      "properties": {
        "label": {
          "description": "`issue` or `pull_request`.",
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "url"
      ],
      "type": "object"
    },
    "ReviewRequested": {
      "additionalProperties": false,
      "description": "A pull request that asks a person for a review and did not at the previous poll.",
      "properties": {
        "author": {
          "description": "The GitHub login who opened it; null for a deleted user.",
          "type": [
            "string",
            "null"
          ]
        },
        "baseline": {
          "description": "True when the event came from the first poll of its stream.",
          "type": "boolean"
        },
        "pull_request": {
          "description": "The pull request number.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "repo": {
          "description": "`owner/name`.",
          "type": "string"
        },
        "reviewer": {
          "description": "The GitHub login asked for the review, as the trigger names it.",
          "type": "string"
        },
        "since": {
          "description": "When the intake first found the request: the time of that poll.",
          "format": "date-time",
          "type": "string"
        },
        "time": {
          "description": "When the event happened, RFC 3339.",
          "format": "date-time",
          "type": "string"
        },
        "title": {
          "description": "The pull request title when the intake polled.",
          "type": "string"
        },
        "triggers": {
          "description": "The triggers the event matched, so the triggers it requests tasks for; may be empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "url": {
          "description": "The pull request's page on GitHub.",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "pull_request",
        "title",
        "url",
        "author",
        "since",
        "reviewer",
        "time",
        "baseline",
        "triggers"
      ],
      "type": "object"
    }
  },
  "description": "A pull request that asks a person for a review and did not at the previous poll.",
  "properties": {
    "data": {
      "$ref": "#/definitions/ReviewRequested"
    },
    "id": {
      "description": "A UUIDv5 of the message's name, so a retried publish keeps its id.",
      "format": "uuid",
      "type": "string"
    },
    "links": {
      "description": "GitHub and Linear events carry one link to the event's page.",
      "items": {
        "$ref": "#/definitions/Link"
      },
      "type": "array"
    },
    "subject": {
      "description": "A short line for listings, such as `owner/name#42`.",
      "type": "string"
    },
    "time": {
      "description": "When the event happened, RFC 3339.",
      "format": "date-time",
      "type": "string"
    },
    "type": {
      "const": "github.pull_request.review_requested",
      "description": "The message type, such as `github.issues.labeled`.",
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "subject",
    "time",
    "data",
    "links"
  ],
  "title": "github.pull_request.review_requested",
  "type": "object"
}
