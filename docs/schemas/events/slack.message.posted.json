{
  "$id": "https://raw.githubusercontent.com/maxence-lefebvre/priory/main/docs/schemas/events/slack.message.posted.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Link": {
      "additionalProperties": false,
      "description": "A link for people.",
      "properties": {
        "label": {
          "description": "`issue` or `pull_request`.",
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "url"
      ],
      "type": "object"
    },
    "SlackPosted": {
      "additionalProperties": false,
      "description": "A message posted in a Slack trigger's channel, outside a thread.",
      "properties": {
        "baseline": {
          "description": "True when the event came from the first poll of its stream.",
          "type": "boolean"
        },
        "channel": {
          "description": "The channel id.",
          "type": "string"
        },
        "files": {
          "default": [],
          "description": "The names of the files uploaded with it; empty when none.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "text": {
          "description": "The message, in Slack's markup.",
          "type": "string"
        },
        "time": {
          "description": "When the event happened, RFC 3339.",
          "format": "date-time",
          "type": "string"
        },
        "triggers": {
          "description": "The triggers the event matched, so the triggers it requests tasks for; may be empty.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ts": {
          "description": "Slack's id of the message: seconds since the epoch, with microseconds.",
          "type": "string"
        },
        "user": {
          "description": "The Slack user id of the author.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "channel",
        "ts",
        "user",
        "text",
        "files",
        "time",
        "baseline",
        "triggers"
      ],
      "type": "object"
    }
  },
  "description": "A message posted in a Slack trigger's channel, outside a thread.",
  "properties": {
    "data": {
      "$ref": "#/definitions/SlackPosted"
    },
    "id": {
      "description": "A UUIDv5 of the message's name, so a retried publish keeps its id.",
      "format": "uuid",
      "type": "string"
    },
    "links": {
      "description": "GitHub and Linear events carry one link to the event's page.",
      "items": {
        "$ref": "#/definitions/Link"
      },
      "type": "array"
    },
    "subject": {
      "description": "A short line for listings, such as `owner/name#42`.",
      "type": "string"
    },
    "time": {
      "description": "When the event happened, RFC 3339.",
      "format": "date-time",
      "type": "string"
    },
    "type": {
      "const": "slack.message.posted",
      "description": "The message type, such as `github.issues.labeled`.",
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "subject",
    "time",
    "data",
    "links"
  ],
  "title": "slack.message.posted",
  "type": "object"
}
