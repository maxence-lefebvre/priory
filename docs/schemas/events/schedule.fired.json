{
  "$id": "https://raw.githubusercontent.com/maxence-lefebvre/priory/main/docs/schemas/events/schedule.fired.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Link": {
      "additionalProperties": false,
      "description": "A link for people.",
      "properties": {
        "label": {
          "description": "`issue` or `pull_request`.",
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "url"
      ],
      "type": "object"
    },
    "ScheduleFired": {
      "additionalProperties": false,
      "description": "A schedule trigger's firing.",
      "properties": {
        "scheduled": {
          "description": "When the firing was due, RFC 3339 in UTC.",
          "format": "date-time",
          "type": "string"
        },
        "trigger": {
          "description": "The trigger's name.",
          "type": "string"
        }
      },
      "required": [
        "trigger",
        "scheduled"
      ],
      "type": "object"
    }
  },
  "description": "A schedule trigger's firing.",
  "properties": {
    "data": {
      "$ref": "#/definitions/ScheduleFired"
    },
    "id": {
      "description": "A UUIDv5 of the message's name, so a retried publish keeps its id.",
      "format": "uuid",
      "type": "string"
    },
    "links": {
      "description": "GitHub and Linear events carry one link to the event's page.",
      "items": {
        "$ref": "#/definitions/Link"
      },
      "type": "array"
    },
    "subject": {
      "description": "A short line for listings, such as `owner/name#42`.",
      "type": "string"
    },
    "time": {
      "description": "When the event happened, RFC 3339.",
      "format": "date-time",
      "type": "string"
    },
    "type": {
      "const": "schedule.fired",
      "description": "The message type, such as `github.issues.labeled`.",
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "subject",
    "time",
    "data",
    "links"
  ],
  "title": "schedule.fired",
  "type": "object"
}
