{
  "$id": "https://raw.githubusercontent.com/maxence-lefebvre/priory/main/docs/schemas/events/priory.task.requested.cli.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "CliRequested": {
      "additionalProperties": false,
      "description": "A task asked for by hand with `priory request`.",
      "properties": {
        "person": {
          "description": "`$USER`; null when it is unset.",
          "type": [
            "string",
            "null"
          ]
        },
        "repo": {
          "description": "`--repo`, a GitHub `owner/name`: `priory request` refuses any other shape.",
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "description": "The request, as typed.",
          "type": "string"
        },
        "time": {
          "description": "When the command ran, RFC 3339.",
          "format": "date-time",
          "type": "string"
        }
      },
      "required": [
        "text",
        "person",
        "time",
        "repo"
      ],
      "type": "object"
    },
    "Link": {
      "additionalProperties": false,
      "description": "A link for people.",
      "properties": {
        "label": {
          "description": "`issue` or `pull_request`.",
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "url"
      ],
      "type": "object"
    }
  },
  "description": "A task asked for by hand with `priory request`.",
  "properties": {
    "data": {
      "$ref": "#/definitions/CliRequested"
    },
    "id": {
      "description": "A UUIDv5 of the message's name, so a retried publish keeps its id.",
      "format": "uuid",
      "type": "string"
    },
    "links": {
      "description": "GitHub and Linear events carry one link to the event's page.",
      "items": {
        "$ref": "#/definitions/Link"
      },
      "type": "array"
    },
    "subject": {
      "description": "A short line for listings, such as `owner/name#42`.",
      "type": "string"
    },
    "time": {
      "description": "When the event happened, RFC 3339.",
      "format": "date-time",
      "type": "string"
    },
    "type": {
      "const": "priory.task.requested.cli",
      "description": "The message type, such as `github.issues.labeled`.",
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "subject",
    "time",
    "data",
    "links"
  ],
  "title": "priory.task.requested.cli",
  "type": "object"
}
