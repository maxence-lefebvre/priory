{
  "$id": "https://raw.githubusercontent.com/maxence-lefebvre/priory/main/docs/schemas/events/priory.memory.dropped.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Link": {
      "additionalProperties": false,
      "description": "A link for people.",
      "properties": {
        "label": {
          "description": "`issue` or `pull_request`.",
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "url"
      ],
      "type": "object"
    },
    "MemoryDropped": {
      "additionalProperties": false,
      "description": "A person drops a memory candidate with `priory memories drop`. No run gets it, not even its own\ntask's.",
      "properties": {
        "candidate": {
          "description": "The `id` of the `priory.memory.written` message.",
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "candidate"
      ],
      "type": "object"
    }
  },
  "description": "A person drops a memory candidate with `priory memories drop`. No run gets it, not even its own\ntask's.",
  "properties": {
    "data": {
      "$ref": "#/definitions/MemoryDropped"
    },
    "id": {
      "description": "A UUIDv5 of the message's name, so a retried publish keeps its id.",
      "format": "uuid",
      "type": "string"
    },
    "links": {
      "description": "GitHub and Linear events carry one link to the event's page.",
      "items": {
        "$ref": "#/definitions/Link"
      },
      "type": "array"
    },
    "subject": {
      "description": "A short line for listings, such as `owner/name#42`.",
      "type": "string"
    },
    "time": {
      "description": "When the event happened, RFC 3339.",
      "format": "date-time",
      "type": "string"
    },
    "type": {
      "const": "priory.memory.dropped",
      "description": "The message type, such as `github.issues.labeled`.",
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "subject",
    "time",
    "data",
    "links"
  ],
  "title": "priory.memory.dropped",
  "type": "object"
}
