{
  "$id": "https://raw.githubusercontent.com/maxence-lefebvre/priory/main/docs/schemas/events/factory.intake.baseline.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Baseline": {
      "additionalProperties": false,
      "description": "Where a stream stands after a poll that moved it; a missing marker means the stream is still\nin its baseline.",
      "properties": {
        "filter": {
          "description": "The view's filter, as Linear reported it at the poll, or the project trigger's filter.\nLinear view and project streams only."
        },
        "members": {
          "anyOf": [
            {
              "$ref": "#/definitions/Members"
            },
            {
              "type": "null"
            }
          ],
          "description": "Every issue in the view or the project, or every pull request asking the reviewer for a\nreview. Linear view, Linear project and review request streams only."
        },
        "position": {
          "$ref": "#/definitions/Position"
        },
        "repo": {
          "description": "`owner/name`. GitHub streams only.",
          "type": [
            "string",
            "null"
          ]
        },
        "seen": {
          "description": "The ids of the events at the position's instant. Linear issue and comment streams only.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "stream": {
          "description": "The stream, such as `github.issues.labeled`, `github.review_requests:octocat`, `linear.comments`\nor `slack.channel:C0123`.",
          "type": "string"
        }
      },
      "required": [
        "stream",
        "position"
      ],
      "type": "object"
    },
    "IssueOrder": {
      "description": "Where a Linear issue stands in its project, as the intake saw it.",
      "properties": {
        "milestone": {
          "anyOf": [
            {
              "$ref": "#/definitions/MilestoneOrder"
            },
            {
              "type": "null"
            }
          ],
          "description": "The issue's milestone; null without one."
        },
        "project_id": {
          "description": "Linear's id of the project.",
          "type": "string"
        },
        "sort_order": {
          "description": "The issue's manual order in Linear. Lower comes first.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "project_id",
        "milestone",
        "sort_order"
      ],
      "type": "object"
    },
    "Link": {
      "additionalProperties": false,
      "description": "A link for people.",
      "properties": {
        "label": {
          "description": "`issue` or `pull_request`.",
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "url"
      ],
      "type": "object"
    },
    "Member": {
      "description": "An issue of a Linear view or project.",
      "properties": {
        "issue": {
          "description": "The issue identifier, such as `ENG-7`.",
          "type": "string"
        },
        "labels": {
          "description": "The issue's label names.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "linear_id": {
          "description": "Linear's id of what the event is about: the issue, history entry or comment. A webhook's\nstate change has no history entry, so it holds the issue's id.",
          "type": "string"
        },
        "order": {
          "anyOf": [
            {
              "$ref": "#/definitions/IssueOrder"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where the issue stands in its project; null without a project."
        },
        "project": {
          "description": "The issue's project name; null without one.",
          "type": [
            "string",
            "null"
          ]
        },
        "project_id": {
          "description": "Linear's id of the issue's project; null without one.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "description": "The issue's state name.",
          "type": "string"
        },
        "team": {
          "description": "The issue's team key.",
          "type": "string"
        },
        "title": {
          "description": "The issue title.",
          "type": "string"
        },
        "url": {
          "description": "The issue's page, or the comment's for a comment.",
          "type": "string"
        }
      },
      "required": [
        "issue",
        "linear_id",
        "title",
        "url",
        "team",
        "project",
        "project_id",
        "state",
        "labels"
      ],
      "type": "object"
    },
    "Members": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/definitions/Member"
          },
          "type": "array"
        },
        {
          "items": {
            "$ref": "#/definitions/RequestedPull"
          },
          "type": "array"
        }
      ],
      "description": "The members of a set stream."
    },
    "MilestoneOrder": {
      "description": "Where a milestone stands in its project.",
      "properties": {
        "id": {
          "description": "Linear's id of the milestone.",
          "type": "string"
        },
        "sort_order": {
          "description": "The milestone's manual order in its project. Lower comes first.",
          "format": "double",
          "type": "number"
        },
        "target_date": {
          "description": "The milestone's target date, `YYYY-MM-DD`; null without one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "sort_order",
        "target_date"
      ],
      "type": "object"
    },
    "Position": {
      "anyOf": [
        {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "string"
        }
      ],
      "description": "A GitHub id or number, a count of set changes, a Linear time or a Slack `ts`."
    },
    "RequestedPull": {
      "description": "An open pull request that asks a person for a review, as GitHub's search lists it.",
      "properties": {
        "author": {
          "description": "The GitHub login who opened it; null for a deleted user.",
          "type": [
            "string",
            "null"
          ]
        },
        "pull_request": {
          "description": "The pull request number.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "repo": {
          "description": "`owner/name`.",
          "type": "string"
        },
        "since": {
          "description": "When the intake first found the request: the time of that poll.",
          "format": "date-time",
          "type": "string"
        },
        "title": {
          "description": "The pull request title when the intake polled.",
          "type": "string"
        },
        "url": {
          "description": "The pull request's page on GitHub.",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "pull_request",
        "title",
        "url",
        "author",
        "since"
      ],
      "type": "object"
    }
  },
  "description": "Where a stream stands after a poll that moved it; a missing marker means the stream is still\nin its baseline.",
  "properties": {
    "data": {
      "$ref": "#/definitions/Baseline"
    },
    "id": {
      "description": "A UUIDv5 of the message's name, so a retried publish keeps its id.",
      "format": "uuid",
      "type": "string"
    },
    "links": {
      "description": "GitHub and Linear events carry one link to the event's page.",
      "items": {
        "$ref": "#/definitions/Link"
      },
      "type": "array"
    },
    "subject": {
      "description": "A short line for listings, such as `owner/name#42`.",
      "type": "string"
    },
    "time": {
      "description": "When the event happened, RFC 3339.",
      "format": "date-time",
      "type": "string"
    },
    "type": {
      "const": "factory.intake.baseline",
      "description": "The message type, such as `github.issues.labeled`.",
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "subject",
    "time",
    "data",
    "links"
  ],
  "title": "factory.intake.baseline",
  "type": "object"
}
