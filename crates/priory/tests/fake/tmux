#!/usr/bin/env bash
# Runs the real tmux, found on PATH after this directory. FAKE_DIR/tmux-hang makes `load-buffer` hang
# in a helper that ignores TERM and keeps stdout open. FAKE_DIR/tmux-hang-panes makes `list-panes` hang the same way.
# FAKE_DIR/tmux-fail-clients makes `list-clients` fail.
if [ "$1" = load-buffer ] && [ -e "$FAKE_DIR/tmux-hang" ]; then (trap '' TERM; sleep 60) & sleep 60; fi
if [ "$1" = list-panes ] && [ -e "$FAKE_DIR/tmux-hang-panes" ]; then (trap '' TERM; sleep 60) & sleep 60; fi
if [ "$1" = list-clients ] && [ -e "$FAKE_DIR/tmux-fail-clients" ]; then echo "tmux: failed" >&2; exit 1; fi
exec "$(PATH=${PATH#*:} command -v tmux)" "$@"
