#!/bin/sh
# A fake decision model. It reads the question on stdin and answers from answers.tsv in its working
# folder: the first line whose text the question's state holds gives its choice, probability and
# model.
# The choice `sleep` sleeps that many seconds, and `garbage` prints what is not an answer.
input=$(cat)
printf '%s\n' "$input" >> calls.log
env > seen-env
if [ -z "$TYPESAFE_API_KEY" ]; then
  echo "no key" >&2
  exit 1
fi
state=${input#*'"state":'}
tab=$(printf '\t')
while IFS="$tab" read -r text choice probability model; do
  case "$state" in
    *"$text"*)
      case "$choice" in
        sleep) sleep "$probability" ;;
        garbage) echo "not an answer" ;;
        *) printf '{"model":"%s","answers":{"triage":{"type":"choice","choice":"%s","probabilities":{"%s":%s}}},"usage":{"input_tokens":100}}\n' \
             "$model" "$choice" "$choice" "$probability" ;;
      esac
      exit 0
      ;;
  esac
done < answers.tsv
echo "no answer for: $input" >&2
exit 1
