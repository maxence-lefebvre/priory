#!/usr/bin/env bash
# A stand-in for the GitHub CLI's pull request and issue commands. Appends each call's arguments, as a JSON
# array, to FAKE_DIR/gh.log. FAKE_DIR/open-pr holds the number `pr list` reports as open, unless FAKE_DIR/prs holds what it prints, and
# FAKE_DIR/gh-fail makes `pr create` fail and FAKE_DIR/gh-hang makes it hang. FAKE_DIR/issues holds what `issue list` prints.
# FAKE_DIR/pr-state holds the state `pr view` prints, OPEN by default. `pr comment` appends the body
# it reads on stdin to FAKE_DIR/pr-comments, and `api repos/<repo>/statuses/<sha>` prints `{}`. `pr create` numbers its pull
# requests 7, 8, 9 and on, in order, and `pr edit` prints the URL of the pull request it edits. `api user` names the login in FAKE_DIR/gh-user, and fails without it.
# `api repos/{owner}/{repo}` prints FAKE_DIR/repo, and fails without it. `api repos/<repo>/rules/branches/<b>`
# prints FAKE_DIR/rules, `[]` by default, and `api repos/<repo>/branches/<b>` prints FAKE_DIR/branch, unprotected by default.
set -u
jq -nc '$ARGS.positional' --args -- "$@" >> "$FAKE_DIR/gh.log"
case "$1 $2" in
  "pr list")
    if [ -e "$FAKE_DIR/prs" ]; then cat "$FAKE_DIR/prs"
    elif [ -e "$FAKE_DIR/open-pr" ]; then echo "[{\"number\":$(cat "$FAKE_DIR/open-pr"),\"baseRefName\":\"main\"}]"; else echo '[]'; fi ;;
  "pr view")
    if [ -e "$FAKE_DIR/pr-state" ]; then cat "$FAKE_DIR/pr-state"; else echo OPEN; fi ;;
  "pr create")
    # A helper that ignores TERM and keeps stdout open, as a stuck credential helper can.
    if [ -e "$FAKE_DIR/gh-hang" ]; then (trap '' TERM; sleep 60) & sleep 60; fi
    if [ -e "$FAKE_DIR/gh-fail" ]; then echo 'pull request create failed: GraphQL: denied' >&2; exit 1; fi
    echo "https://github.com/owner/repo/pull/$((6 + $(grep -c '^\["pr","create"' "$FAKE_DIR/gh.log")))" ;;
  "pr edit")
    echo "https://github.com/owner/repo/pull/$3" ;;
  "issue list")
    if [ -e "$FAKE_DIR/issues" ]; then cat "$FAKE_DIR/issues"; else echo '[]'; fi ;;
  "api user")
    if [ -e "$FAKE_DIR/gh-user" ]; then echo "{\"login\":\"$(cat "$FAKE_DIR/gh-user")\"}"; else echo 'gh: HTTP 502' >&2; exit 1; fi ;;
  "pr comment")
    cat >> "$FAKE_DIR/pr-comments"
    echo "https://github.com/owner/repo/pull/$3#issuecomment-1" ;;
  "api repos/{owner}/{repo}")
    if [ -e "$FAKE_DIR/repo" ]; then cat "$FAKE_DIR/repo"; else echo 'none of the git remotes configured for this repository point to a known GitHub host' >&2; exit 1; fi ;;
  "api repos/"*"/rules/branches/"*)
    if [ -e "$FAKE_DIR/rules" ]; then cat "$FAKE_DIR/rules"; else echo '[]'; fi ;;
  "api repos/"*"/branches/"*)
    if [ -e "$FAKE_DIR/branch" ]; then cat "$FAKE_DIR/branch"; else echo '{"name":"main","protection":{"enabled":false}}'; fi ;;
  "api repos/"*"/statuses/"*)
    echo '{}' ;;
  "issue create")
    echo 'https://github.com/owner/repo/issues/9' ;;
  *) echo "fake gh: unexpected $*" >&2; exit 1 ;;
esac
