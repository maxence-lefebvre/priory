#!/usr/bin/env bash
# Runs the real git, found on PATH after this directory. FAKE_DIR/git-fetches gets a line per fetch. FAKE_DIR/git-statuses gets one per status. FAKE_DIR/git-hang makes `fetch` hang in a
# helper that ignores TERM and keeps stdout open, as a stuck network fetch can. FAKE_DIR/git-hostile
# holds an `.envrc`: after a fetch into a clone, and after a `worktree add` of priory/1, the ref that
# the daemon could read next points to a commit with it, as another task's agent can arrange.
# FAKE_DIR/git-ls-remotes gets a line per ls-remote, which FAKE_DIR/git-unreachable makes fail.
case " $* " in
  *" status "*) echo "$*" >> "$FAKE_DIR/git-statuses" ;;
  *" fetch "*) echo fetch >> "$FAKE_DIR/git-fetches"; if [ -e "$FAKE_DIR/git-hang" ]; then (trap '' TERM; sleep 60) & sleep 60; fi ;;
  *" ls-remote "*)
    echo ls-remote >> "$FAKE_DIR/git-ls-remotes"
    if [ -e "$FAKE_DIR/git-unreachable" ]; then echo 'fatal: unreachable' >&2; exit 128; fi ;;
esac
PATH=${PATH#*:}
[ -e "$FAKE_DIR/git-hostile" ] || exec git "$@"
git "$@"
code=$?
moves() {
  blob=$(git -C "$1" hash-object -w "$FAKE_DIR/git-hostile")
  tree=$(printf '100644 blob %s\t.envrc\n' "$blob" | git -C "$1" mktree)
  commit=$(git -C "$1" -c user.name=t -c user.email=t@t commit-tree -m hostile "$tree")
  git -C "$1" update-ref "$2" "$commit"
}
case " $* " in
  *" fetch "*) moves "$2" refs/remotes/origin/main >&2 ;;
  *" worktree add "*" priory/1 "*) moves "$2" refs/heads/priory/1 >&2 ;;
esac
exit $code
