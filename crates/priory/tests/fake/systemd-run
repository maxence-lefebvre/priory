#!/usr/bin/env bash
# A stand-in for `systemd-run --scope`: appends its options, one call per line, to
# FAKE_DIR/systemd-run.log, then runs the command after `--` in its place, as a scope does.
# FAKE_DIR/no-systemd makes it fail as on a host with no systemd user manager.
if [ -e "$FAKE_DIR/no-systemd" ]; then
  echo 'Failed to connect to bus: No medium found' >&2
  exit 1
fi
options=()
while [ $# -gt 0 ] && [ "$1" != -- ]; do options+=("$1"); shift; done
shift
echo "${options[*]}" >> "$FAKE_DIR/systemd-run.log"
exec "$@"
