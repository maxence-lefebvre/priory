#!/usr/bin/env bash
# A stand-in for curl as the daemon's OTLP exporter calls it. It appends a line to FAKE_DIR/curl.log
# per call. With FAKE_DIR/curl-fail, it removes that file and exits 7, as curl does when it cannot
# connect. With FAKE_DIR/curl-status, it removes that file and prints its HTTP status as
# `--write-out` does. Otherwise it appends {url, body} to FAKE_DIR/otlp.jsonl, reading the body from
# `--data-binary @file`, and prints 200.
set -u
url=''
body=''
while [ $# -gt 0 ]; do
  case "$1" in
    --data-binary) body=${2#@}; shift 2 ;;
    http://*|https://*) url=$1; shift ;;
    *) shift ;;
  esac
done
echo "$url" >> "$FAKE_DIR/curl.log"
if [ -e "$FAKE_DIR/curl-fail" ]; then
  rm -f "$FAKE_DIR/curl-fail"
  echo 'curl: (7) Failed to connect to 127.0.0.1 port 4318' >&2
  exit 7
fi
if [ -e "$FAKE_DIR/curl-status" ]; then
  cat "$FAKE_DIR/curl-status"
  rm -f "$FAKE_DIR/curl-status"
  exit 0
fi
jq -c --arg url "$url" '{url: $url, body: .}' "$body" >> "$FAKE_DIR/otlp.jsonl"
printf 200
