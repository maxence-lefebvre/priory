#!/usr/bin/env bash
# A stand-in for systemctl: appends its arguments, one call per line, to FAKE_DIR/systemctl.log.
# FAKE_DIR/no-systemd makes it fail as on a host with no systemd user manager.
if [ -e "$FAKE_DIR/no-systemd" ]; then
  echo 'Failed to connect to bus: No medium found' >&2
  exit 1
fi
# `show` prints the cgroup path in FAKE_DIR/slice-cgroup, unlogged.
if [ "${2-}" = show ]; then
  cat "$FAKE_DIR/slice-cgroup" 2>/dev/null || echo /priory-agents.slice
  exit 0
fi
echo "$*" >> "$FAKE_DIR/systemctl.log"
