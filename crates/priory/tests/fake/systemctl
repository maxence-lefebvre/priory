#!/usr/bin/env bash
# A stand-in for systemctl: appends its arguments, one call per line, to FAKE_DIR/systemctl.log.
# FAKE_DIR/no-systemd makes it fail as on a host with no systemd user manager.
if [ -e "$FAKE_DIR/no-systemd" ]; then
  echo 'Failed to connect to bus: No medium found' >&2
  exit 1
fi
# `show` prints the cgroup path in FAKE_DIR/slice-cgroup, logged in FAKE_DIR/shown.log.
if [ "${2-}" = show ]; then
  echo "$*" >> "$FAKE_DIR/shown.log"
  cat "$FAKE_DIR/slice-cgroup" 2>/dev/null || echo /priory-agents.slice
  exit 0
fi
# Setting the agents slice puts FAKE_DIR/capped, if any, in its cgroup's cpu.max.
if [ "${4-}" = priory-agents.slice ] && [ -e "$FAKE_DIR/capped" ]; then
  cp "$FAKE_DIR/capped" "$FAKE_DIR/../cgroup/priory-agents.slice/cpu.max"
fi
echo "$*" >> "$FAKE_DIR/systemctl.log"
