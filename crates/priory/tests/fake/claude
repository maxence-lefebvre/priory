#!/usr/bin/env bash
# A stand-in for Claude Code: runs the --settings hooks as Claude would and logs every prompt typed into it.
# FAKE_DIR holds args.log, env.log (variable names), otel.log (OTEL_RESOURCE_ATTRIBUTES, if set), pid, typed.log, pending (a paste arrived), submitted (a prompt was submitted),
# the hold files hold-submit, hold-call (after the submit, before the turn's tool call) and hold-stop,
# drop-enter (the number of Enters after a paste to lose), burst (lose an Enter that comes within 0.2s
# of its paste), dropped.log (one line per lost Enter),
# silent (show its content and never report a hook, as when Claude waits on its trust dialog),
# silent-resume (the same, only when launched with --resume, as Claude 2.1.330 on some resumes), and
# die (show its content and exit before any hook, as a harness that fails to start), and
# crash (exit before the turn's Stop, leaving a dead pane as a tmux with remain-on-exit does).
# A prompt after `--` is the first turn. FAKE_LAZY_START fires SessionStart with the first turn, as
# Codex 0.170 does, rather than at startup.
# Each turn pops the first line of FAKE_DIR/calls, if any: a tools/call params object such as
# {"name":"result","arguments":{...}}, or a JSON array of them to call in turn. It calls that tool through the --mcp-config server, or, for
# AskUserQuestion, runs the matching PreToolUse hooks, and appends the reply to tools.log. Any other
# capitalized or mcp__ name first runs the PreToolUse hooks its matcher matches and logs a decision
# they print. Otherwise an mcp__ call logs {"passed": name}, and a capitalized name is a built-in tool that needs permission: it runs the PermissionRequest hooks, and
# when none decides, shows the prompt through the permission_prompt Notification hooks.
# Under FAKE_CODEX_MODEL, as the fake codex runs it, a turn writes Codex's session file instead.
# Each turn n, counted across launches in FAKE_DIR/turns, appends to FAKE_DIR/transcript.jsonl, as
# Claude's session transcript, one assistant message written as two lines, as Claude writes one per
# content block, using 100+n input, 10+n output, 1000+n cache read and 50+n cache write tokens.
# FAKE_DIR/late-tokens writes them after the turn's tool call, as Claude's last message of a turn.
# A turn that pops a first line N off FAKE_DIR/context writes N input tokens and no others instead, so the
# session's context is N. FAKE_DIR/no-transcript skips that write. FAKE_DIR/compact fires SessionStart with source compact
# mid-turn, as Claude does when it compacts the conversation.
# A typed prompt that starts with /compact is no turn: it fires SessionStart with source compact, as
# Claude does, or with FAKE_LAZY_START PostCompact, then SessionStart with source compact at the next
# turn, as Codex 0.170 does, and no UserPromptSubmit or Stop.
# With -p, it is a handler call: it appends its stdin to handler.log, ended by ---, and its args to
# handler-args.log, then prints Claude's --output-format json with the first line of
# FAKE_DIR/handler as its result, which it pops, or a leave answer when none is left. A line that
# starts with a double quote is a JSON string, decoded, so a result can hold several lines. With
# FAKE_DIR/handler-fail, it then exits 1.
# --version prints Claude Code 2.1.330's version line.
# FAKE_DIR/probe, a shell script, runs once at start in the run's folder, with its output in probe.log.
# A call with an `output` key stands for a built-in tool that ran: it appends the tool_use and its
# tool_result, with that output, to FAKE_DIR/transcript.jsonl as Claude writes them, and no hook hears it.
set -u
if [ "${1-}" = --version ]; then
  echo '2.1.330 (Claude Code)'
  exit 0
fi
# `claude mcp get NAME` logs NAME to mcp-get.log, then finds it as Claude Code 2.1.330 does when
# FAKE_DIR/connectors lists it, one name a line, and otherwise exits 1 naming no such server.
if [ "${1-}" = mcp ] && [ "${2-}" = get ]; then
  printf '%s\n' "$3" >> "$FAKE_DIR/mcp-get.log"
  if grep -qxF -- "$3" "$FAKE_DIR/connectors" 2>/dev/null; then
    printf '%s:\n  Scope: claude.ai\n  Status: \xe2\x9c\x93 Connected\n' "$3"
    exit 0
  fi
  printf 'No MCP server named "%s". Run `claude mcp add` to add one.\n' "$3" >&2
  exit 1
fi
if [[ " $* " == *" -p "* ]]; then
  { cat; echo '---'; } >> "$FAKE_DIR/handler.log"
  printf '%s\n' "$@" >> "$FAKE_DIR/handler-args.log"
  answer='{"action":"leave","why":"no answer queued"}'
  if [ -s "$FAKE_DIR/handler" ]; then
    answer=$(head -n 1 "$FAKE_DIR/handler")
    sed -i 1d "$FAKE_DIR/handler"
  fi
  jq -nc --arg answer "$answer" '{type: "result", subtype: "success", is_error: false,
    result: (if ($answer | startswith("\"")) then ($answer | fromjson) else $answer end), session_id: "fake-session",
    total_cost_usd: 0.0021, usage: {input_tokens: 300, output_tokens: 20, cache_read_input_tokens: 0, cache_creation_input_tokens: 40},
    modelUsage: {"claude-fake-haiku": {inputTokens: 300, outputTokens: 20, cacheReadInputTokens: 0, cacheCreationInputTokens: 40, costUSD: 0.0021}}}'
  [ -e "$FAKE_DIR/handler-fail" ] && exit 1
  exit 0
fi
settings='{}'
mcp='{}'
session=''
first=''
resumed=''
# Bash writes one argument at a time, and a test reads the file once it names the session.
printf '%s\n' "$@" > "$FAKE_DIR/args.log.$$"
mv "$FAKE_DIR/args.log.$$" "$FAKE_DIR/args.log"
echo $$ > "$FAKE_DIR/pid"
env | cut -d= -f1 > "$FAKE_DIR/env.log"
printf %s "$XDG_RUNTIME_DIR" > "$FAKE_DIR/xdg.log"
env | grep '^OTEL_RESOURCE_ATTRIBUTES=' > "$FAKE_DIR/otel.log"
[ -e "$FAKE_DIR/probe" ] && sh "$FAKE_DIR/probe" > "$FAKE_DIR/probe.log" 2>&1
while [ $# -gt 0 ]; do
  case "$1" in
    --session-id) session=$2; shift 2 ;;
    --resume) session=$2; resumed=1; shift 2 ;;
    --settings) settings=$2; shift 2 ;;
    # Claude Code takes the config as JSON or as a file's path.
    --mcp-config) if [ -f "$2" ]; then mcp=$(cat "$2"); else mcp=$2; fi; shift 2 ;;
    --) first=$2; shift 2 ;;
    *) shift ;;
  esac
done

transcript_file="$FAKE_DIR/transcript.jsonl"
[ -n "${FAKE_CODEX_MODEL-}" ] && transcript_file="$FAKE_DIR/codex-session.jsonl"

hook() {
  jq -r --arg event "$1" '.hooks[$event][]?.hooks[]?.command' <<<"$settings" | while IFS= read -r command; do
    jq -nc --arg session "$session" --arg event "$1" --arg prompt "${2-}" --arg source "${3-}" --arg transcript "$transcript_file" \
      '{session_id: $session, hook_event_name: $event, transcript_path: $transcript} + if $prompt == "" then {} else {prompt: $prompt} end
        + if $source == "" then {} else {source: $source} end' | sh -c "$command"
  done
}

# Runs the PreToolUse hooks whose matcher matches the tool $1, with input $2, and prints their output.
pretool() {
  jq -r --arg name "$1" '.hooks.PreToolUse[]? | select(.matcher as $m | $m != "AskUserQuestion" and ($name | test("^(" + $m + ")$"))) | .hooks[].command' <<<"$settings" |
    while IFS= read -r command; do
      jq -nc --arg session "$session" --arg name "$1" --argjson input "$2" --arg cwd "$PWD" \
        '{session_id: $session, hook_event_name: "PreToolUse", tool_name: $name, tool_input: $input, cwd: $cwd}' |
        sh -c "$command"
    done
}

# Writes a built-in tool call that ran, and what it printed, to the transcript.
ran() {
  [ -e "$FAKE_DIR/no-transcript" ] && return
  local id
  id="toolu_$(wc -l < "$FAKE_DIR/transcript.jsonl" 2>/dev/null || echo 0)"
  jq -c --arg id "$id" '{type: "assistant", message: {id: "msg_\($id)", role: "assistant",
    content: [{type: "tool_use", id: $id, name: .name, input: (.arguments // {})}]}}' <<<"$1" >> "$FAKE_DIR/transcript.jsonl"
  jq -c --arg id "$id" '{type: "user", message: {role: "user",
    content: [{type: "tool_result", tool_use_id: $id, content: .output, is_error: false}]}}' <<<"$1" >> "$FAKE_DIR/transcript.jsonl"
}

# Calls one tool as Claude does: start the server, initialize, then tools/call.
tool() {
  if jq -e 'has("output")' <<<"$1" > /dev/null; then
    ran "$1"
    return
  fi
  local name
  name=$(jq -r .name <<<"$1")
  if [ "$name" = AskUserQuestion ]; then
    jq -r '.hooks.PreToolUse[]? | select(.matcher == "AskUserQuestion") | .hooks[].command' <<<"$settings" |
      while IFS= read -r command; do
        jq -nc --arg session "$session" '{session_id: $session, hook_event_name: "PreToolUse", tool_name: "AskUserQuestion"}' |
          sh -c "$command" >> "$FAKE_DIR/tools.log"
        echo >> "$FAKE_DIR/tools.log"
      done
    return
  fi
  if [[ $name == [A-Z]* || $name == mcp__* ]]; then
    local guarded
    guarded=$(pretool "$name" "$(jq -c '.arguments // {}' <<<"$1")")
    if [ -n "$guarded" ]; then
      printf '%s\n' "$guarded" >> "$FAKE_DIR/tools.log"
      return
    fi
    if [[ $name == mcp__* ]]; then
      jq -nc --arg name "$name" '{passed: $name}' >> "$FAKE_DIR/tools.log"
      return
    fi
  fi
  if [[ $name == [A-Z]* ]]; then
    local decided=''
    # undecided: the prompt shows although a hook should have decided, as when that hook fails.
    [ -e "$FAKE_DIR/undecided" ] || decided=$(jq -r '.hooks.PermissionRequest[]?.hooks[].command' <<<"$settings" |
      while IFS= read -r command; do
        jq -nc --arg session "$session" --arg name "$name" --argjson input "$(jq -c '.arguments // {}' <<<"$1")" \
          '{session_id: $session, hook_event_name: "PermissionRequest", tool_name: $name, tool_input: $input}' |
          sh -c "$command"
      done)
    if [ -n "$decided" ]; then
      printf '%s\n' "$decided" >> "$FAKE_DIR/tools.log"
      return
    fi
    jq -r '.hooks.Notification[]? | select(.matcher == "permission_prompt") | .hooks[].command' <<<"$settings" |
      while IFS= read -r command; do
        jq -nc --arg session "$session" --arg name "$name" \
          '{session_id: $session, hook_event_name: "Notification", notification_type: "permission_prompt", message: "Claude needs your permission to use \($name)"}' |
          sh -c "$command"
      done
    return
  fi
  local command args env reply
  command=$(jq -r '.mcpServers.priory.command' <<<"$mcp")
  mapfile -t args < <(jq -r '.mcpServers.priory.args[]' <<<"$mcp")
  mapfile -t env < <(jq -r '.mcpServers.priory.env // {} | to_entries[] | "\(.key)=\(.value)"' <<<"$mcp")
  coproc server { env "${env[@]}" "$command" "${args[@]}"; }
  echo '{"jsonrpc":"2.0","id":0,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"fake","version":"0"}}}' >&"${server[1]}"
  read -r reply <&"${server[0]}"
  echo '{"jsonrpc":"2.0","method":"notifications/initialized"}' >&"${server[1]}"
  jq -c '{jsonrpc: "2.0", id: 1, method: "tools/call", params: .}' <<<"$1" >&"${server[1]}"
  read -r reply <&"${server[0]}"
  printf '%s\n' "$reply" >> "$FAKE_DIR/tools.log"
  exec {server[1]}>&-
  wait "$server_PID"
}

wait_while() { while [ -e "$FAKE_DIR/$1" ]; do sleep 0.05; done; }

# Whether to lose this Enter: FAKE_DIR/drop-enter holds how many Enters after a paste are lost.
# Each lost one adds a line to dropped.log.
dropped() {
  local left
  left=$(cat "$FAKE_DIR/drop-enter" 2>/dev/null) || return 1
  [ "${left:-0}" -gt 0 ] || return 1
  echo $((left - 1)) > "$FAKE_DIR/drop-enter"
  echo >> "$FAKE_DIR/dropped.log"
}

started=''
start() {
  [ -n "$started" ] && return
  started=1
  hook SessionStart
}

printf '\e[?2004h'
if [ -e "$FAKE_DIR/die" ]; then
  cat "$FAKE_DIR/die"
  exit 1
fi
if [ -n "$resumed" ] && [ -e "$FAKE_DIR/silent-resume" ]; then
  cat "$FAKE_DIR/silent-resume"
  exec sleep infinity
fi
if [ -e "$FAKE_DIR/silent" ]; then
  cat "$FAKE_DIR/silent"
  exec sleep infinity
fi
[ -n "${FAKE_LAZY_START-}" ] || start
while :; do
  prompt=''
  if [ -n "$first" ]; then
    prompt="$first"$'\n'
  elif [ -e "$FAKE_DIR/burst" ]; then
    # Reads key by key, as Claude does, and takes keys that arrive within 0.2s of a paste's end as
    # part of the paste, as when it reads them in one burst: an Enter among them submits nothing.
    stty -icanon
    while IFS= read -r -N 1 key || exit 0; do
      [ -z "$prompt" ] && [ "$key" = $'\n' ] && continue
      prompt+=$key
      [[ $prompt == *$'\e[201~' ]] && break
    done
    printf '%s' "$prompt" > "$FAKE_DIR/pending"
    while IFS= read -r -N 1 -t 0.2 key; do
      [ "$key" = $'\n' ] && echo >> "$FAKE_DIR/dropped.log"
    done
    while IFS= read -r -N 1 key || exit 0; do
      [ "$key" = $'\n' ] && break
    done
    prompt+=$'\n'
  else
    # A pane killed mid-read must exit here, not log an empty prompt and take the next queued call.
    ended=''
    while IFS= read -r line || exit 0; do
      # An Enter on an empty input submits nothing, as in Claude.
      [ -z "$prompt" ] && [ -z "$line" ] && continue
      if [ -z "$ended" ]; then
        prompt+="$line"$'\n'
        [[ $line == *$'\e[201~'* ]] || continue
        ended=1
        printf '%s' "$prompt" > "$FAKE_DIR/pending"
      fi
      dropped || break
    done
  fi
  prompt=${prompt//$'\e[200~'/}
  prompt=${prompt//$'\e[201~'/}
  start
  [ -n "${compacted-}" ] && hook SessionStart '' compact
  compacted=''
  printf '%s' "$prompt" > "$FAKE_DIR/pending"
  wait_while hold-submit
  printf '%s---\n' "$prompt" >> "$FAKE_DIR/typed.log"
  if [[ $prompt == /compact* ]]; then
    if [ -n "${FAKE_LAZY_START-}" ]; then hook PostCompact; compacted=1; else hook SessionStart '' compact; fi
    continue
  fi
  # Claude Code 2.1.328 hands hooks a pasted prompt wrapped in a pasted_content tag.
  # trailer: text Claude would submit after the tag, so the prompt is not the one typed alone.
  trailer=''
  [ -e "$FAKE_DIR/trailer" ] && trailer=$(cat "$FAKE_DIR/trailer")
  if [ -n "$first" ]; then
    hook UserPromptSubmit "$first"
    first=''
  else
    hook UserPromptSubmit $'\n\n<pasted_content id="9d7a">\n'"${prompt%$'\n'}"$'</pasted_content id="9d7a">'"$trailer"
  fi
  turn=$(( $(cat "$FAKE_DIR/turns" 2>/dev/null || echo 0) + 1 ))
  echo "$turn" > "$FAKE_DIR/turns"
  context=''
  if [ -s "$FAKE_DIR/context" ]; then
    context=$(head -n 1 "$FAKE_DIR/context")
    sed -i 1d "$FAKE_DIR/context"
  fi
  message=$(jq -nc --argjson n "$turn" --arg context "$context" '{type: "assistant", message: {id: "msg_\($n)", model: "claude-fake-5",
    usage: (if $context == "" then {input_tokens: (100 + $n), output_tokens: (10 + $n), cache_read_input_tokens: (1000 + $n), cache_creation_input_tokens: (50 + $n)}
      else {input_tokens: ($context | tonumber), output_tokens: 0, cache_read_input_tokens: 0, cache_creation_input_tokens: 0} end)}}')
  tokens() {
    if [ -n "${FAKE_CODEX_MODEL-}" ]; then
      # Codex counts cached input inside input_tokens.
      # A context line makes the call's whole input that size, as for Claude.
      [ -e "$FAKE_DIR/no-transcript" ] || jq -nc --argjson n "$turn" --arg model "$FAKE_CODEX_MODEL" --arg context "$context" \
        '{type: "turn_context", payload: {model: $model}},
         {type: "event_msg", payload: {type: "token_count", info: {
           total_token_usage: {input_tokens: (2000 + $n), cached_input_tokens: 0, output_tokens: 0, reasoning_output_tokens: 0, total_tokens: (2000 + $n)},
           last_token_usage: (if $context == "" then {input_tokens: (300 + $n), cached_input_tokens: 100, output_tokens: (20 + $n), reasoning_output_tokens: 0, total_tokens: (320 + 2 * $n)}
             else {input_tokens: ($context | tonumber), cached_input_tokens: 0, output_tokens: 0, reasoning_output_tokens: 0, total_tokens: ($context | tonumber)} end)}}}' \
        >> "$transcript_file"
    else
      [ -e "$FAKE_DIR/no-transcript" ] || printf '%s\n%s\n' "$message" "$message" >> "$FAKE_DIR/transcript.jsonl"
    fi
  }
  [ -e "$FAKE_DIR/late-tokens" ] || tokens
  printf '%s' "$turn" > "$FAKE_DIR/submitted"
  [ -e "$FAKE_DIR/compact" ] && hook SessionStart '' compact
  wait_while hold-call
  # Two runs' turns can end at once, so the pop holds a lock and each call reaches one turn.
  call=$({ flock 9; [ -s "$FAKE_DIR/calls" ] && head -n 1 "$FAKE_DIR/calls" && sed -i 1d "$FAKE_DIR/calls"; } 9>>"$FAKE_DIR/calls.lock")
  if [ -n "$call" ]; then
    if [[ $call == \[* ]]; then
      while IFS= read -r one; do tool "$one"; done < <(jq -c '.[]' <<<"$call")
    elif [ -n "$call" ]; then
      tool "$call"
    fi
  fi
  [ -e "$FAKE_DIR/late-tokens" ] && tokens
  if [ -e "$FAKE_DIR/crash" ]; then
    tmux set-option -p remain-on-exit on
    exit 1
  fi
  wait_while hold-stop
  hook Stop
  printf 'fake turn %s ended\n' "$turn"
done
