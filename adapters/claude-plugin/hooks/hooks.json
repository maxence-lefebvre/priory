{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "priory hook PreToolUse --outside"
          }
        ]
      }
    ],
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "priory hook SessionStart --outside" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "priory hook UserPromptSubmit --outside" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "priory hook Stop --outside" }] }
    ]
  }
}
