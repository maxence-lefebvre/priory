{
  "manifest_version": 3,
  "name": "Priory on GitHub",
  "version": "1.3.1",
  "description": "Shows the Priory task that holds a pull request, its asks and a review guide, on GitHub's pull request page.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": { "192": "icon-192.png" },
  "permissions": ["sidePanel"],
  "host_permissions": ["https://github.com/*", "http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [
    { "matches": ["https://github.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "web_accessible_resources": [
    { "resources": ["frame.html", "lib/pr.js"], "matches": ["https://github.com/*"] }
  ],
  "side_panel": { "default_path": "command.html" },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; connect-src https: http://127.0.0.1:* http://localhost:*; base-uri 'none'; form-action 'none'; frame-ancestors https://github.com"
  }
}
