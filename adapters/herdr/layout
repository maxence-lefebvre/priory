#!/usr/bin/env node
// Prints every view's Herdr layout, keyed by its file name: `priory views --json | layout`.
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";
import { layouts } from "./lib/layout.js";

let views, input = "";
try {
  input = readFileSync(0, "utf8");
  views = JSON.parse(input).views;
} catch {
  views = null;
}
if (!views?.default) {
  console.error("layout: reads the views on its standard input; pipe `priory views --json` into it");
  process.exit(1);
}
const frame = JSON.parse(readFileSync(new URL("./layouts/frame.json", import.meta.url), "utf8"));
try {
  // The root id carries a hash of the view files, so `install`, `priory check` and the Priory bar can tell a layout built from older ones.
  console.log(JSON.stringify(layouts(views, frame, createHash("sha256").update(input.trim()).digest("hex").slice(0, 12)), null, 2));
} catch (error) {
  console.error(`layout: ${error instanceof Error ? error.message : error}`);
  process.exit(1);
}
