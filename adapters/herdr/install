#!/usr/bin/env bash
# Links each mod in adapters/herdr/mods into Herdr's mods folder (`--copy` copies it instead, for a
# Herdr behind Syncthing, which carries no links; only a copy holding .priory-installed is replaced),
# and writes one layout per view into its layouts folder, `default` as priory.json and each other view
# as priory-NAME.json: `priory views --json | install [--copy] [--dry-run]`. It says whether the
# layout it replaces was built from the same view files. A dry run prints the links and the layouts
# instead. It removes its own copy or link of a mod the adapter no longer ships, and its own layout
# of a view that is gone. It refuses, before changing anything, to replace a mod that is not its own
# link or a layout it did not write. HERDR_APP_HOME names Herdr's folder,
# as Herdr reads it.
set -euo pipefail

dry_run=false copy=false
for arg in "$@"; do
  case "$arg" in
    --dry-run) dry_run=true ;;
    --copy) copy=true ;;
    *) echo "usage: priory views --json | install [--copy] [--dry-run]" >&2; exit 2 ;;
  esac
done

adapter="$(cd "$(dirname "$0")" && pwd)"
app="${HERDR_APP_HOME:-$HOME/.config/herdr-app}"
layout="$app/layouts/priory.json"

sources=() targets=()
for mod in "$adapter"/mods/*/; do
  mod="${mod%/}"
  sources+=("$mod") targets+=("$app/mods/$(basename "$mod")")
done

for folder in "$app" "$app/mods" "$app/layouts"; do
  if [[ -e "$folder" && ! -d "$folder" ]]; then
    echo "install: ${folder#"$app"/} is not a folder; move it away first" >&2
    exit 1
  fi
done

generated="$("$adapter/layout")"

marker=.priory-installed
for i in "${!targets[@]}"; do
  target="${targets[$i]}"
  [[ -e "$target" || -L "$target" ]] || continue
  [[ -L "$target" && "$(readlink "$target")" == "${sources[$i]}" ]] && continue
  if [[ -d "$target" && ! -L "$target" && -f "$target/$marker" ]]; then
    $copy && continue
    echo "install: ${target#"$app"/} is a copy: run \`install --copy\` again, or move it away first" >&2
    exit 1
  fi
  if $copy; then
    echo "install: ${target#"$app"/} is not a link or a copy this adapter made; move it away first" >&2
  else
    echo "install: ${target#"$app"/} is not a link to this adapter; move it away first" >&2
  fi
  exit 1
done
commit="$(git -C "$adapter" rev-parse HEAD 2>/dev/null || echo unknown)"
# The generated layouts are keyed by file name: `generated_layout FILE` prints one.
generated_layout() { printf '%s' "$generated" | node -e 'console.log(JSON.stringify(JSON.parse(require("fs").readFileSync(0, "utf8"))[process.argv[1]], null, 2))' "$1"; }
root_id() { node -e 'try { console.log(JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).id ?? "") } catch {}' "$1"; }
own_id='^priory-generated(-[0-9a-f]{12})?$'
files=()
while IFS= read -r file; do files+=("$file"); done < <(printf '%s' "$generated" | node -e 'for (const file of Object.keys(JSON.parse(require("fs").readFileSync(0, "utf8")))) console.log(file)')
# Its own layout is a file whose root id is the frame's, with or without a hash, or the priory.json link an earlier install made.
installed_id=""
for file in "${files[@]}"; do
  path="$app/layouts/$file"
  if [[ -L "$path" ]]; then
    [[ "$file" == priory.json && "$(readlink "$path")" == "$adapter/layouts/priory.json" ]] && continue
  elif [[ -f "$path" ]]; then
    id="$(root_id "$path")"
    [[ "$file" == priory.json ]] && installed_id="$id"
    [[ "$id" =~ $own_id ]] && continue
  elif [[ ! -e "$path" ]]; then
    continue
  fi
  echo "install: layouts/$file is not a layout this adapter wrote; move it away first" >&2
  exit 1
done

for i in "${!targets[@]}"; do
  source="${sources[$i]}" target="${targets[$i]}"
  if $copy; then
    echo "copy $target <- $source"
    $dry_run && continue
    mkdir -p "$(dirname "$target")"
    # Stage the copy beside Herdr's folders, so a failed copy leaves the installed mod as it was.
    stage="$app/.priory-staging/$(basename "$target")"
    rm -rf -- "${stage:?}" "${stage:?}.old"
    mkdir -p "$(dirname "$stage")"
    cp -R -- "$source" "$stage"
    printf '%s\n' "$commit" > "$stage/$marker"
    # Only a link to this adapter or a folder with the marker is at the target, so this replaces what an install made.
    if [[ -L "$target" || -d "$target" ]]; then mv -- "$target" "$stage.old"; fi
    mv -- "$stage" "$target" || { [[ -e "$stage.old" || -L "$stage.old" ]] && mv -- "$stage.old" "$target"; exit 1; }
    rm -rf -- "${stage:?}.old"
  elif [[ -L "$target" ]]; then
    echo "linked already $target"
  elif $dry_run; then
    echo "link $target -> $source"
  else
    mkdir -p "$(dirname "$target")"
    ln -s "$source" "$target"
    echo "link $target -> $source"
  fi
done

# Removes what an earlier install made of a mod this adapter no longer ships: a copy with the marker, or a link into this adapter.
for stale in "$app"/mods/*; do
  [[ -d "$adapter/mods/$(basename "$stale")" ]] && continue
  if [[ -L "$stale" ]]; then
    [[ "$(readlink "$stale")" == "$adapter/mods/$(basename "$stale")" ]] || continue
  elif [[ ! -f "$stale/$marker" ]]; then
    continue
  fi
  echo "remove $stale"
  $dry_run || rm -rf -- "${stale:?}"
done

# Removes a layout an earlier install wrote for a view that is gone: a file with its own root id.
for stale in "$app"/layouts/priory-*.json; do
  [[ -f "$stale" && ! -L "$stale" ]] || continue
  [[ "$(root_id "$stale")" =~ $own_id ]] || continue
  for file in "${files[@]}"; do [[ "$file" == "$(basename "$stale")" ]] && continue 2; done
  echo "remove $stale"
  $dry_run || rm -f -- "${stale:?}"
done

new_id="$(generated_layout priory.json | node -e 'console.log(JSON.parse(require("fs").readFileSync(0, "utf8")).id)')"
if [[ -n "$installed_id" && "$installed_id" == "$new_id" ]]; then
  echo "layout is up to date with the view files"
elif [[ -n "$installed_id" ]]; then
  echo "layout was older than the view files, and $($dry_run && echo would be || echo is) rewritten"
fi
for file in "${files[@]}"; do
  path="$app/layouts/$file"
  echo "write $path"
  if $dry_run; then
    generated_layout "$file"
    continue
  fi
  mkdir -p "$app/layouts"
  # A failed write leaves the old layout: write beside it, then rename over it, which also replaces an old link.
  generated_layout "$file" > "$path.tmp"
  mv -f -- "$path.tmp" "$path"
done
