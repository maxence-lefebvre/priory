#!/usr/bin/env bash
# Links each mod in adapters/herdr/mods into Herdr's mods folder, and writes the layout for the
# `default` view into its layouts folder: `priory views --json | install [--dry-run]`. A dry run
# prints the links and the layout instead. It refuses, before changing anything, to replace a mod
# that is not its own link or a priory.json it did not write. HERDR_APP_HOME names Herdr's folder,
# as Herdr reads it.
set -euo pipefail

dry_run=false
case "${1-}" in
  "") ;;
  --dry-run) dry_run=true ;;
  *) echo "usage: priory views --json | install [--dry-run]" >&2; exit 2 ;;
esac

adapter="$(cd "$(dirname "$0")" && pwd)"
app="${HERDR_APP_HOME:-$HOME/.config/herdr-app}"
layout="$app/layouts/priory.json"

sources=() targets=()
for mod in "$adapter"/mods/*/; do
  mod="${mod%/}"
  sources+=("$mod") targets+=("$app/mods/$(basename "$mod")")
done

for folder in "$app" "$app/mods" "$app/layouts"; do
  if [[ -e "$folder" && ! -d "$folder" ]]; then
    echo "install: ${folder#"$app"/} is not a folder; move it away first" >&2
    exit 1
  fi
done

generated="$("$adapter/layout")"

for i in "${!targets[@]}"; do
  target="${targets[$i]}"
  if [[ -e "$target" || -L "$target" ]] && [[ "$(readlink "$target")" != "${sources[$i]}" ]]; then
    echo "install: ${target#"$app"/} is not a link to this adapter; move it away first" >&2
    exit 1
  fi
done
# Its own layout is the link an earlier install made, or a file whose root has the frame's id.
if [[ -L "$layout" ]]; then
  own=$([[ "$(readlink "$layout")" == "$adapter/layouts/priory.json" ]] && echo true || echo false)
elif [[ -e "$layout" ]]; then
  own=$(grep -qx '  "id": "priory-generated",' "$layout" && echo true || echo false)
else
  own=true
fi
if ! $own; then
  echo "install: layouts/priory.json is not a layout this adapter wrote; move it away first" >&2
  exit 1
fi

for i in "${!targets[@]}"; do
  source="${sources[$i]}" target="${targets[$i]}"
  if [[ -L "$target" ]]; then
    echo "linked already $target"
  elif $dry_run; then
    echo "link $target -> $source"
  else
    mkdir -p "$(dirname "$target")"
    ln -s "$source" "$target"
    echo "link $target -> $source"
  fi
done

echo "write $layout"
if $dry_run; then
  printf '%s\n' "$generated"
  exit 0
fi
mkdir -p "$app/layouts"
# Writing through the old link would write into the adapter, so the link goes first.
if [[ -L "$layout" ]]; then rm -- "$layout"; fi
printf '%s\n' "$generated" > "$layout"
