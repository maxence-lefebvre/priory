#!/usr/bin/env bash
# Links each mod in adapters/herdr/mods into Herdr's mods folder, and the layout into its layouts
# folder: `install [--dry-run]`. It refuses, before linking anything, to replace a file that is not
# its own link. HERDR_APP_HOME names Herdr's folder, as Herdr reads it.
set -euo pipefail

dry_run=false
case "${1-}" in
  "") ;;
  --dry-run) dry_run=true ;;
  *) echo "usage: install [--dry-run]" >&2; exit 2 ;;
esac

adapter="$(cd "$(dirname "$0")" && pwd)"
app="${HERDR_APP_HOME:-$HOME/.config/herdr-app}"

sources=() targets=()
for mod in "$adapter"/mods/*/; do
  mod="${mod%/}"
  sources+=("$mod") targets+=("$app/mods/$(basename "$mod")")
done
sources+=("$adapter/layouts/priory.json") targets+=("$app/layouts/priory.json")

for i in "${!targets[@]}"; do
  target="${targets[$i]}"
  if [[ -e "$target" || -L "$target" ]] && [[ "$(readlink "$target")" != "${sources[$i]}" ]]; then
    echo "install: ${target#"$app"/} is not a link to this adapter; move it away first" >&2
    exit 1
  fi
done

for i in "${!targets[@]}"; do
  source="${sources[$i]}" target="${targets[$i]}"
  if [[ -L "$target" ]]; then
    echo "linked already $target"
  elif $dry_run; then
    echo "link $target -> $source"
  else
    mkdir -p "$(dirname "$target")"
    ln -s "$source" "$target"
    echo "link $target -> $source"
  fi
done
